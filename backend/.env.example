CHECKOUT_ENV=production
CHECKOUT_DB_PATH=/data/checkout_access.sqlite3
CHECKOUT_PII_SECRET=<generate-a-long-random-secret>
FRONTEND_URL=https://fonsecatools.com.br
MONTHLY_PRICE=150
TRIAL_HOURS=72
COUPON_CODE=FONSECA5
COUPON_PERCENT=5

# O backend descobre o username do bot via getMe.
TELEGRAM_BOT_TOKEN=<reference-existing-ia-over-secret>
TELEGRAM_CONSENSUS_CHAT_ID=<reference-existing-consensus-chat-id>
# Opcional: se omitido, o backend deriva um secret a partir de CHECKOUT_PII_SECRET.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INVITE_TTL_SECONDS=900
AUTO_CONFIGURE_TELEGRAM_WEBHOOK=1
# Opcional no Railway: RAILWAY_PUBLIC_DOMAIN é detectado automaticamente.
PUBLIC_BASE_URL=

MERCADOPAGO_ACCESS_TOKEN=<paste-directly-in-cloud-secret>
MERCADOPAGO_WEBHOOK_SECRET=<from-Mercado-Pago-Webhooks-after-public-url-exists>

INTERNAL_API_KEY=<generate-a-random-secret>
ENABLE_EXPIRY_WORKER=1
EXPIRY_SCAN_SECONDS=60
