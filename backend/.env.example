CHECKOUT_ENV=production
CHECKOUT_DB_PATH=/data/checkout_access.sqlite3
CHECKOUT_PII_SECRET=<generate-a-long-random-secret>
FRONTEND_URL=https://fonsecatools.com.br
MONTHLY_PRICE=150
TRIAL_HOURS=72
COUPON_CODE=FONSECA5
COUPON_PERCENT=5

TELEGRAM_BOT_TOKEN=<paste-directly-in-cloud-secret>
TELEGRAM_BOT_USERNAME=<bot_username_without_at>
TELEGRAM_CONSENSUS_CHAT_ID=<existing_consensus_chat_id>
TELEGRAM_WEBHOOK_SECRET=<generate-a-random-secret>
TELEGRAM_INVITE_TTL_SECONDS=900

MERCADOPAGO_ACCESS_TOKEN=<paste-directly-in-cloud-secret>
MERCADOPAGO_WEBHOOK_SECRET=<from-Mercado-Pago-Webhooks>

INTERNAL_API_KEY=<generate-a-random-secret>
ENABLE_EXPIRY_WORKER=1
EXPIRY_SCAN_SECONDS=60
